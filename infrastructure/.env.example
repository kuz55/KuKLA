# KuKLA infrastructure environment template
# Copy to infrastructure/.env for local deployment.
# Never commit the real .env file.

POSTGRES_DB=kukla
POSTGRES_USER=kukla
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated origins are not accepted by every CORS configuration.
# Set the exact origin(s) required by the deployed client, or configure the
# server for an appropriate origin policy before production use.
CORS_ORIGIN=http://localhost:3000
