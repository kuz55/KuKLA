# KuKLA infrastructure environment template
# Copy to infrastructure/.env for local deployment.
# Never commit the real .env file.

POSTGRES_DB=kukla
POSTGRES_USER=kukla
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Local server port. Keep 18080 for the normal installation.
# Use 18081 for a parallel test clone.
SERVER_PORT=18080

# Exact client origins. For a production Tauri build include its origin,
# for example http://tauri.localhost on Windows/Android.
CORS_ORIGIN=http://localhost:3000

# Keep false for production. Enable only when public self-registration is intended.
ALLOW_PUBLIC_REGISTRATION=false
