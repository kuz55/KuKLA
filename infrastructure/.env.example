# KuKLA infrastructure environment template
# Copy to .env. The installer generates both secrets; when configuring manually,
# replace the empty values with unique random values before starting Compose.
# Never commit the real .env file.

POSTGRES_DB=kukla
POSTGRES_USER=kukla
POSTGRES_PASSWORD=
JWT_SECRET=

# Local Compose API port, bound to loopback. Use HTTPS through the production
# Nginx profile for remote/mobile clients.
SERVER_PORT=18080
SERVER_BIND=127.0.0.1

# Exact origin of the desktop application. For browser development use:
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=tauri://localhost

# Default Docker Compose bridge range used by the Nginx reverse proxy.
# Change this if your Docker network uses a different subnet.
TRUST_PROXY=172.16.0.0/12

# Keep false for production. Enable only when public self-registration is intended.
ALLOW_PUBLIC_REGISTRATION=false
