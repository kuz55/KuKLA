# KuKLA infrastructure environment template
# Copy to infrastructure/.env for local deployment.
# Never commit the real .env file.

POSTGRES_DB=kukla
POSTGRES_USER=kukla
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Local server port. Keep 18080 for the normal installation.
# Use 18081 for a parallel test clone.
SERVER_PORT=18080

# Exact client origin used by the Desktop production build on Linux/macOS.
# For Windows/Android Tauri builds use http://tauri.localhost instead.
# For browser development use http://localhost:3000.
CORS_ORIGIN=tauri://localhost

# Keep false for production. Enable only when public self-registration is intended.
ALLOW_PUBLIC_REGISTRATION=false
